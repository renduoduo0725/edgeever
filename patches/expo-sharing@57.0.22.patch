-  return intent.type != null && allowedShareActions.contains(intent.action)
+  // Android can recreate a task with its original SEND intent. That is a
+  // history launch, not a new share, even after the JS process has been killed.
+  return intent.flags and Intent.FLAG_ACTIVITY_LAUNCHED_FROM_HISTORY == 0 &&
+    intent.type != null && allowedShareActions.contains(intent.action)
