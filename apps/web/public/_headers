# Always validate application entry points against the active deployment.
# Fingerprinted assets below can remain cached indefinitely.
/
  Cache-Control: no-cache, no-store, must-revalidate

/settings
  Cache-Control: no-cache, no-store, must-revalidate

/templates
  Cache-Control: no-cache, no-store, must-revalidate

/evernote-migration
  Cache-Control: no-cache, no-store, must-revalidate

/*.html
  Cache-Control: no-cache, no-store, must-revalidate

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.webmanifest
  Cache-Control: no-cache, no-store, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Anonymous share and form links: the token in the URL is the only secret.
/share/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet, noimageindex
  Cache-Control: private, no-store
  Referrer-Policy: no-referrer

/form/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet, noimageindex
  Cache-Control: private, no-store
  Referrer-Policy: no-referrer
