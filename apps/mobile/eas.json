{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production"
    }
  },
  "submit": {
    "store-internal": {
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      }
    },
    "store-alpha": {
      "android": {
        "track": "alpha",
        "releaseStatus": "completed"
      }
    },
    "store-beta": {
      "android": {
        "track": "beta",
        "releaseStatus": "completed"
      }
    },
    "store-production": {
      "android": {
        "track": "production",
        "releaseStatus": "completed"
      }
    }
  }
}
